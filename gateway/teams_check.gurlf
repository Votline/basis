[invite_to_team]
URL:http://localhost:8080/api/v1/teams/{RESPONSE id=0 json:id}/invite
Method:POST
Body:`
{
    "user_id": {ENVIRONMENT key=UserID ; from=check_envs},
    "role": "member"
}
`
Headers:`
    Content-Type: application/json
    Authorization: Bearer {ENVIRONMENT key=UserToken ; from=check_envs}
`
ID:2
Type:http
Response:`{"status":"invited"}
`
