[create_team]
URL:http://localhost:8080/api/v1/teams
Method:POST
Body:`
{
    "name": "{RANDOM oneof=uuid}"
}
`
Headers:`
    Content-Type: application/json
    Authorization: Bearer {ENVIRONMENT key=UserToken ; from=check_envs}
`
ID:0
Type:http
Response:`{"id":9,"name":"2a1a0468-16ef-489c-b589-85ef7760b9b8","created_by":10,"created_at":"0001-01-01T00:00:00Z","role":"owner"}
`
[\create_team]

