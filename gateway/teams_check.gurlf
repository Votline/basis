[create_team]
URL:http://localhost:8080/api/v1/teams
Method:POST
Body:`
{
    "name": "{RANDOM oneof=uuid}"
}
`
Headers:`
    Content-Type: application/json
    Authorization: Bearer {ENVIRONMENT key=UserToken ; from=check_envs}
`
ID:0
Type:http
Response:`{"id":14,"name":"7229d43c-bcbc-4b06-9012-a1926552920a","created_by":12,"created_at":"0001-01-01T00:00:00Z","role":"owner"}
`
[\create_team]

[get_teams]
