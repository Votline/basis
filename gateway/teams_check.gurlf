[invite_to_team]
URL:http://localhost:8080/api/v1/teams/14/invite
Method:POST
Body:`
{
    "user_id": {ENVIRONMENT key=UserID ; from=check_envs},
    "role": "member"
}
`
Headers:`
    Content-Type: application/json
    Authorization: Bearer {ENVIRONMENT key=UserToken ; from=check_envs}
`
