# Server
PORT=8080
GLOBAL_CONTEXT_TIMEOUT=5
PROMETHEUS_PORT=9090

# MySQL Database
DB_HOST=db
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=task_management
DB_ROOT_PASSWORD=root_pass
DB_DSN=${DB_USER}:${DB_PASSWORD}@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}?parseTime=true

# DB Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5
DB_CONN_MAX_IDLE_TIME=5
DB_PING_TIMEOUT=5

# Redis Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_PING_TIMEOUT=5
REDIS_RATELIMIT_LIMIT=100
REDIS_RATELIMIT_WINDOW=1

# App Secrets
JWT_SECRET=change_me
